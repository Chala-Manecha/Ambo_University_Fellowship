  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1",
    "@react-router/dev": "^7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31",
    "typescript": "^5",
